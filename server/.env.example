# Copy this file to .env and fill in real values.
# Connection string for your MongoDB instance.
MONGODB_URI=mongodb://localhost:27017/habitflow

# Long random string used to sign JWT tokens. Keep it secret.
JWT_SECRET=replace_with_a_long_random_string

# Port the Express API will listen on.
PORT=5000

# Origin allowed by CORS. Vite dev server defaults to 5173.
CLIENT_ORIGIN=http://localhost:5173
